# Keep this file to simple KEY=VALUE lines only.
# Copy to .env if needed:
#   cp .env.example .env
# ./login.sh uses this file for the rootless interactive login step and then
# syncs the resulting auth/device state into the rootful service volumes.
# ./run.sh installs .env to /etc/pangolin-client/pangolin-client.env for the
# rootful system service.

# Use the Pangolin dashboard URL, not the auth subdomain.
PANGOLIN_ENDPOINT=https://vpn.example.com

# Optional: pass client credentials through to Pangolin.
# The proven host flow still starts with ./login.sh so the required auth/device
# state exists before the rootful service starts.
PANGOLIN_CLIENT_ID=
PANGOLIN_CLIENT_SECRET=

# Optional: select an organization if your Pangolin deployment requires it.
PANGOLIN_ORG=

# Optional runtime tuning.
# PANGOLIN_INTERFACE_NAME=
# PANGOLIN_MTU=
# PANGOLIN_LOG_LEVEL=info
# PANGOLIN_HTTP_ADDR=
# PANGOLIN_NETSTACK_DNS=
# PANGOLIN_UPSTREAM_DNS=
# PANGOLIN_ROUTE_DOMAINS=home.arpa
# PANGOLIN_HOLEPUNCH=true
# PANGOLIN_OVERRIDE_DNS=
# PANGOLIN_TUNNEL_DNS=
# PANGOLIN_TLS_CLIENT_CERT=
